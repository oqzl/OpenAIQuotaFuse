# Admin key used only for the Organization Usage API.
# Organization Owners create it at:
# https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=

# Normal project API key used only for inference by the `run` command.
# Keep this separate from OPENAI_ADMIN_KEY.
OPENAI_API_KEY=

# OpenAI usage tier. Tiers 1-2 receive the smaller complimentary quota;
# tiers 3-5 receive the larger quota.
OPENAI_USAGE_TIER=1

# Percentage of each daily complimentary quota kept unused as a safety reserve.
OPENAI_QUOTA_RESERVE_PERCENT=5

# Hard local annual budget for intentional paid fallback, in USD.
# Set to 0 to disable paid fallback entirely.
OPENAI_ANNUAL_PAID_BUDGET_USD=5

# Optional persistent ledger path. Default:
# ${XDG_STATE_HOME:-$HOME/.local/state}/openai-quota-fuse/paid-usage.json
# OPENAI_QUOTA_FUSE_PAID_LEDGER=
