# Admin key used only for the Organization Usage API.
OPENAI_ADMIN_KEY=

# Normal project API key used only for inference by the `run` command.
# Keep this separate from OPENAI_ADMIN_KEY.
OPENAI_API_KEY=

# OpenAI usage tier. Tiers 1-2 receive the smaller complimentary quota;
# tiers 3-5 receive the larger quota.
OPENAI_USAGE_TIER=1

# Percentage of each daily complimentary quota kept unused as a safety reserve.
OPENAI_QUOTA_RESERVE_PERCENT=5
